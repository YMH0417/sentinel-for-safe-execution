{
  "name": "sentinel-backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npx tsx watch src/index.ts",
    "build": "npx tsc && npx copyfiles -u 1 \"src/**/*.json\" dist/",
    "start": "node dist/index.js",
    "verify:swaps": "powershell -ExecutionPolicy Bypass -File scripts/verify-swaps.ps1",
    "sync:env": "powershell -ExecutionPolicy Bypass -File ../scripts/sync-backend-env.ps1"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ethers": "^6.15.0",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.1.1",
    "copyfiles": "^2.4.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
