# Auto-generated by scripts/sync-backend-env.ps1 when running .\start-demo.ps1
# Do not hand-edit unless debugging — re-run start-demo.ps1 after Anvil restart.

# Use "mock" for frontend/backend demo without Anvil.
# Omit CHAIN_MODE or set to "rpc"/"demo" to read on-chain demo pools.
CHAIN_MODE=demo

# Demo chain profile: anvil-local | anvil-fork-monad | monad-testnet
# See shared/demo-chain-profiles.json
DEMO_PROFILE=anvil-local

# JSON-RPC endpoint for the network where demo pools are deployed.
RPC_URL=http://127.0.0.1:8545

# Optional: override deployment manifest path (default from DEMO_PROFILE -> local-31337-demo.json)
# DEMO_DEPLOYMENT_PATH=../contracts/deployments/local-31337-demo.json

# Optional: override registry address from deployment file
# DEMO_REGISTRY_ADDRESS=

# VaultExecution deployment address on the same network.
VAULT_EXECUTION_ADDRESS=

# Account that submits executeRoute transactions and pays gas.
EXECUTOR_PRIVATE_KEY=

# Demo swap wallet — local profile defaults to Anvil #0 via chainConfig; remote requires explicit keys.
# SWAP_PRIVATE_KEY=

# Agent signer for EIP-712 permits (router one-tx swap). Local profile defaults to Anvil #0.
# AGENT_PRIVATE_KEY=

# DemoSwapRouter address (from DeployAllDemo output) — enables Vault+swap in one tx.
# DEMO_SWAP_ROUTER_ADDRESS=

# Optional: override scenario deployer (otherwise read from registry.deployer()).
# DEMO_SCENARIO_DEPLOYER=

# AI alert analysis (Dashboard) — Groq OpenAI-compatible API (default).
# Also editable in frontend Settings → 大模型（AI 警报分析）, which syncs this file.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_RESPONSE_LANGUAGE=zh
# Aliases: GROQ_API_KEY / GROQ_BASE_URL / GROQ_MODEL, or OPENAI_*.
# LLM_ANALYSIS_ENABLED=true
# LLM_TIMEOUT_MS=10000
