# Use "mock" for frontend/backend demo without Anvil.
# Any other value keeps real RPC behavior.
CHAIN_MODE=mock

# JSON-RPC endpoint for the network where VaultExecution is deployed.
# Local Anvil default:
RPC_URL=http://127.0.0.1:8545

# VaultExecution deployment address on the same network.
VAULT_EXECUTION_ADDRESS=

# Account that submits executeRoute transactions and pays gas.
# This is NOT the DevE Agent signer key.
EXECUTOR_PRIVATE_KEY=
